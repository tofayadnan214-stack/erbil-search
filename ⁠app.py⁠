import os
import sqlite3
import requests
from flask import Flask, render_template_string, request

app = Flask(__name__)

# لێرە لینکی دابەزاندنی داتابەیسەکەت لە Pixeldrain دابنە
DB_URL = "لێرە_لینکەکەی_پیکسڵدرەینت_دانێ"
DB_PATH = "erbil.db"


def download_db():
  if not os.path.exists(DB_PATH):
    print("سەرقاڵی داگرتنی داتابەیسین...")
    response = requests.get(DB_URL, stream=True)
    with open(DB_PATH, "wb") as f:
      for chunk in response.iter_content(chunk_size=8192):
        if chunk:
          f.write(chunk)
    print("داتابەیسەکە بە سەرکەوتوویی داگیرا!")


# داگرتنی داتابەیس پێش کارپێکردنی سایتەکە
download_db()


@app.route("/")
def home():
  return "سایتەکە بە سەرکەوتوویی کار دەکات و داتابەیسەکە ئامادەیە!"


if __name__ == "__main__":
  app.run(host="0.0.0.0", port=7860)
  
